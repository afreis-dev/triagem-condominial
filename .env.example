# PostgreSQL - Desenvolvimento local
POSTGRES_USER=triagem
POSTGRES_PASSWORD=triagem_dev
POSTGRES_DB=triagem_db_dev
POSTGRES_PORT=5432

# Ambiente: development ou production
APP_ENV=development

# Gere um valor aleatório forte e mantenha-o fora do Git.
JWT_SECRET=
# Origens exatas do frontend, separadas por vírgula.
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Para frontend e API em sites distintos, usar none somente com HTTPS.
COOKIE_SAMESITE=lax

# Banco de desenvolvimento
DATABASE_URL_DEV=postgresql://triagem:triagem_dev@localhost:5432/triagem_db_dev

# Banco de produção
# DATABASE_URL_PROD=postgresql://usuario:senha@servidor/banco

# Banco exclusivo para testes
# TEST_DATABASE_URL=postgresql://usuario:senha@localhost:5432/triagem_db_test

# Classificação com IA (H07). Sem IA_ATIVA=true, só as regras classificam
IA_ATIVA=false
GEMINI_API_KEY=
IA_MODELO=gemini-3.5-flash-lite
